{
  "name": "grayboard",
  "version": "1.10.0",
  "description": "Durable Claude-to-Claude message bus over the channels protocol",
  "type": "module",
  "private": true,
  "bin": {
    "grayboard": "src/cli/main.ts",
    "grayboard-server": "src/server/main.ts"
  },
  "scripts": {
    "server": "bun src/server/main.ts",
    "cli": "bun src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run build:cli && bun run build:server",
    "build:cli": "bun build --compile src/cli/main.ts    --outfile dist/grayboard",
    "build:server": "bun build --compile src/server/main.ts --outfile dist/grayboard-server"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.0.0",
    "jose": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
