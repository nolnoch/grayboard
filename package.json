{
  "name": "grayboard",
  "version": "2.2.0",
  "description": "Durable Claude-to-Claude message bus over the channels protocol",
  "type": "module",
  "private": true,
  "bin": {
    "grayboard": "src/cli/main.ts",
    "grayboard-server": "src/server/main.ts"
  },
  "scripts": {
    "server": "bun src/server/main.ts",
    "cli": "bun src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./tests",
    "test:opencode": "bash scripts/e2e.sh hosted-strict",
    "test:opencode:host": "bash scripts/e2e.sh hosted-host",
    "test:opencode:config": "bash scripts/e2e.sh hosted-config",
    "build": "bun run build:cli && bun run build:server",
    "build:cli": "bash scripts/build_scratch.sh bun build --compile \"$PWD/src/cli/main.ts\"    --outfile \"$PWD/dist/grayboard\"",
    "build:server": "bash scripts/build_scratch.sh bun build --compile \"$PWD/src/server/main.ts\" --outfile \"$PWD/dist/grayboard-server\""
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.0.0",
    "jose": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@oh-my-pi/pi-coding-agent": "18.14.0",
    "@opencode-ai/plugin": "1.19.4",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
