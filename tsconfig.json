{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "adapters/pi/**/*.ts", "adapters/pi-family/**/*.ts", "adapters/omp/**/*.ts", "adapters/opencode/**/*.ts", "adapters/hosted-core/src/**/*.ts"]
}
