#!/usr/bin/env bash
# Git pre-push hook. Install once per clone: git config core.hooksPath scripts/hooks
#
# 1. Docs gate (scripts/docs_gate.sh) per pushed sha, cheapest first so a refused push fails
#    in seconds. Bypass: DOCS_GATE_BYPASS=1 git push ...
# 2. Typecheck, then the test files the push itself adds or changes, on the working tree.
#    Kept to about a minute: git opens its SSH connection before this hook runs, so a hook that
#    outlives it ends in SIGPIPE (exit 141) after every gate passed (#456). The full root suite
#    and the hosted suites are CI's job (.github/workflows/test.yml, hosted.yml), which merge
#    enforcement requires.
#
# Bypass everything (sparingly): git push --no-verify
set -u

# readlink -f follows a symlinked install (.git/hooks/pre-push -> scripts/hooks/pre-push). BSD
# readlink before macOS 12.3 has no -f and prints nothing: fall back to $0, which core.hooksPath
# (the documented install) runs directly (#93).
self="$(readlink -f "$0" 2>/dev/null)" || self=""
HOOK_SCRIPTS="$(cd "$(dirname "${self:-$0}")/.." && pwd -P)"

# One line per ref on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>.
# An all-zero local_sha is a deletion; skip it.
refs=()
shas=()
bases=()
while read -r local_ref local_sha _remote_ref remote_sha; do
  if [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  refs+=("$local_ref")
  shas+=("$local_sha")
  # A new branch has no remote sha: compare against where it left master.
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    bases+=("$(git merge-base "$local_sha" origin/master 2>/dev/null || echo "")")
  else
    bases+=("$remote_sha")
  fi
done

if [[ "${#shas[@]}" = "0" ]]; then
  echo "[pre-push] Nothing to push (deletion only); skipping checks."
  exit 0
fi

for i in "${!shas[@]}"; do
  if ! bash "$HOOK_SCRIPTS/docs_gate.sh" "${shas[$i]}"; then
    echo "[pre-push] Docs gate refused ${shas[$i]} (${refs[$i]}); push aborted." >&2
    exit 1
  fi
done

if [[ "$(bun --version)" != "1.4.4" ]]; then
  echo "[pre-push] Use Bun 1.4.4, matching CI and the package fixtures; push aborted." >&2
  exit 1
fi

echo "[pre-push] Typecheck..."
if ! bun run typecheck; then
  echo "[pre-push] Typecheck failed; push aborted." >&2
  exit 1
fi

# Test files this push adds or changes; none means nothing to run beyond the typecheck.
tests=()
for i in "${!shas[@]}"; do
  [[ -z "${bases[$i]}" ]] && continue
  while IFS= read -r f; do
    [[ -f "$f" ]] && tests+=("$f")
  done < <(git diff --name-only --diff-filter=AM "${bases[$i]}" "${shas[$i]}" -- '*.test.ts' | sort -u)
done

if [[ "${#tests[@]}" -gt 0 ]]; then
  echo "[pre-push] Changed tests: ${tests[*]}"
  if ! bun test --timeout 30000 "${tests[@]}"; then
    echo "[pre-push] Changed tests failed; push aborted." >&2
    exit 1
  fi
fi
